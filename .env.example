# =============================================================================
# 造梦者 (Dream Weaver) 环境变量示例
# 复制为 .env 并填入真实值即可启动
# =============================================================================

# ── 本地 GPUStack / OpenAI 兼容接口（Qwen 系列）──
# 给 planner / extractor / editor / patcher 角色使用
# 推荐部署：https://github.com/gpustack/gpustack（本地 GPU 推理）
API_KEY=your_local_gpustack_key_here
BASE_URL=http://localhost:8000/v1

# ── MiniMax 开放 API（writer 角色使用）──
# 强文笔 + 512k 长上下文，专用于写长篇网文
# 获取 key：登录 MiniMax 开放平台（https://api.minimaxi.com）创建 API key
MINIMAX_API_KEY=your_minimax_open_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 是否禁用 M3 的 thinking 模式
# 写小说时强烈建议开启（true）—— thinking 模式会拖慢且容易跑出推理过程
# 如需用 M3 做深度推理任务（如攻略推荐），可关闭
MINIMAX_THINKING_DISABLED=true

# ── MOCK 模式：跳过所有真实 LLM 调用，返回预设数据 ──
# 设为 1 时无需配置任何 API key 也能完整体验 UI 流程（适合 GitHub 访客快速试用）
# 设 0 或留空 = 正常模式（需要上面 API_KEY / MINIMAX_API_KEY）
MOCK_MODE=0

# ── 可选：跨域白名单 ──
# APP_ALLOWED_ORIGINS=http://127.0.0.1:8050,http://localhost:8050

# ── 可选：初始邀请码（不填则自动生成并写入 .runlogs/bootstrap_invite.txt）──
# INITIAL_INVITE_CODE=

# ── 可选：其他 provider 备注（当前未启用，留作扩展）──
# ZHIPU_API_KEY=
# MODELSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 可选：云端备份（不配置则只备份到本地 .runlogs/cloud_mirror/）──
# 适合挂载的网盘 / NAS
# CLOUD_BACKEND=local
# CLOUD_LOCAL_DIR=D:/backup/novels
# CLOUD_PREFIX=novel_backups

# AWS S3 / S3 兼容（MinIO / Cloudflare R2 等）
# CLOUD_BACKEND=s3
# CLOUD_S3_BUCKET=my-novel-backup
# CLOUD_S3_REGION=us-east-1
# CLOUD_S3_ACCESS_KEY=your_key
# CLOUD_S3_SECRET_KEY=your_secret
# CLOUD_S3_ENDPOINT=https://s3.amazonaws.com   # MinIO 用 http://localhost:9000
# CLOUD_PREFIX=novel_backups

# 阿里云 OSS
# CLOUD_BACKEND=oss
# CLOUD_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# CLOUD_OSS_BUCKET=my-novel-backup
# CLOUD_OSS_ACCESS_KEY=your_key
# CLOUD_OSS_SECRET_KEY=your_secret
# CLOUD_PREFIX=novel_backups
